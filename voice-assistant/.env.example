# Copy to .env and fill in. Shell environment variables override these values.

# --- Required -------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Gemini ----------------------------------------------------------------
# "gemini-flash-latest" always points at the newest Flash model. Pin a specific
# model (see https://ai.google.dev/gemini-api/docs/models) for stable behaviour.
GEMINI_MODEL=gemini-flash-latest
# minimal | low | medium | high. Lower = faster replies. Leave empty for the model default.
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_SECONDS=30
# Retries for rate limits (429), server errors and network drops, with exponential backoff.
MAX_RETRIES=3
# Previous exchanges remembered for follow-ups like "make it shorter". 0 disables memory.
HISTORY_TURNS=6

# --- Speech-to-text ------------------------------------------------------
# gemini-direct (default): the audio goes straight to Gemini, which transcribes AND decides in one call (fastest)
# gemini: separate Gemini transcription call | openai: Whisper API | local: faster-whisper, offline | google: free, rate-limited
STT_BACKEND=gemini-direct
LANGUAGE=en
# Only for STT_BACKEND=openai
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
# Only for STT_BACKEND=local: tiny.en | base.en | small.en | medium.en | large-v3 ...
LOCAL_WHISPER_MODEL=base.en

# --- Push-to-talk --------------------------------------------------------
# Any pynput key name: alt_r (Right Option), cmd_r, ctrl_r, f8, f13 ... or a single character.
HOTKEY=alt_r
# hold = record while the key is held | toggle = tap to start, tap again to stop
PTT_MODE=hold
MIN_RECORD_SECONDS=0.35
MAX_RECORD_SECONDS=60
# Clips quieter than this RMS level are treated as silence. Lower it for a quiet mic.
SILENCE_RMS_THRESHOLD=0.004

# --- Output --------------------------------------------------------------
SPEAK_RESPONSES=true
# Run `say -v '?'` to list voices, e.g. Samantha, Daniel, Karen. Empty = system voice.
TTS_VOICE=
TTS_RATE=190
SOUND_CUES=true
# Seconds between keystrokes when typing.
TYPING_INTERVAL=0.008
# Text longer than this many characters (or containing non-ASCII) is pasted instead of typed.
PASTE_THRESHOLD=300

# --- Misc ----------------------------------------------------------------
# true = log actions instead of opening apps / typing / speaking
DRY_RUN=false
LOG_LEVEL=INFO
