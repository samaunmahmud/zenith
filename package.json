{
  "name": "zenith",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && mvn -q spring-boot:run",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend && cd backend && mvn -q -B package -DskipTests",
    "start": "java -jar backend/target/zenith.jar",
    "test": "npm run test --workspace frontend && cd backend && mvn -q -B test",
    "smoke": "cd backend && mvn -q spring-boot:run -Dspring-boot.run.arguments=--smoke",
    "precache": "cd backend && mvn -q spring-boot:run -Dspring-boot.run.arguments=--precache"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
