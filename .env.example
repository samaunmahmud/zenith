# Nebius Token Factory (OpenAI-compatible). Get a key at https://tokenfactory.nebius.com
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Hard cap on total Token Factory spend in USD, tracked in cache/_spend.json across restarts.
# Calls are refused once it's reached. 0 switches AI calls off entirely.
MAX_SPEND_USD=0.50

# Optional price overrides, USD per 1M tokens (defaults = Token Factory list prices)
# PRICE_NANO_INPUT=0.06
# PRICE_NANO_OUTPUT=0.24
# PRICE_SUPER_INPUT=0.30
# PRICE_SUPER_OUTPUT=0.90
# PRICE_ULTRA_INPUT=1.00
# PRICE_ULTRA_OUTPUT=3.00

# Market data
# Financial Modeling Prep (prices + fundamentals): https://site.financialmodelingprep.com (free: 250 calls/day)
FMP_API_KEY=
# Finnhub (news headlines, optional): https://finnhub.io (free: 60 calls/min)
FINNHUB_API_KEY=

# Server
PORT=3001
# true = never call market data APIs, serve from cache/ only (use for live demos)
DEMO_MODE=false
CACHE_TTL_HOURS=12
DEMO_TICKERS=AAPL,NVDA,JPM,TSLA
