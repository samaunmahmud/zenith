# Nebius Token Factory (OpenAI-compatible). Get a key at https://tokenfactory.nebius.com
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Agents that answer without Nemotron's reasoning pass (faster, fewer tokens): the narrow jobs.
REASONING_OFF=news,technicals,technicals-rebuttal,secretary

# Hard cap on total Token Factory spend in USD, tracked in cache/_spend.json across restarts.
# Calls are refused once it's reached. 0 (also the default when unset) switches AI calls off,
# so spending money is always an explicit choice. Around 0.05 covers a few committee runs.
MAX_SPEND_USD=0

# Budget protection for a public demo (the cap above limits the total; these spread it out):
# serve a ticker's saved decision if it's younger than REUSE_HOURS (0 = always run live, handy while
# iterating on prompts), allow LIVE_RUNS_PER_HOUR paid runs per rolling hour (0 = no hourly limit),
# and at most MAX_CONCURRENT_RUNS at once.
REUSE_HOURS=6
LIVE_RUNS_PER_HOUR=20
MAX_CONCURRENT_RUNS=2
# Live company-name searches per rolling day (2 FMP calls each; the free plan is 250 calls a day). 0 = no limit.
SEARCHES_PER_DAY=60
# Per-visitor limits on a public URL: requests that can call Nemotron (committee, ask, thesis) and live searches,
# per visitor per rolling window. The limits above are global; these stop one visitor from using them all. 0 = off.
RATE_LIMIT_PAID=12
RATE_LIMIT_SEARCH=60
RATE_LIMIT_WINDOW_MINUTES=10

# Optional price overrides, USD per 1M tokens (defaults = Token Factory list prices)
# PRICE_NANO_INPUT=0.06
# PRICE_NANO_OUTPUT=0.24
# PRICE_SUPER_INPUT=0.30
# PRICE_SUPER_OUTPUT=0.90
# PRICE_ULTRA_INPUT=1.00
# PRICE_ULTRA_OUTPUT=3.00

# Market data
# Financial Modeling Prep (prices + fundamentals): https://site.financialmodelingprep.com (free: 250 calls/day)
FMP_API_KEY=
# Finnhub (news headlines, forward P/E, and fundamentals/profile for symbols FMP's free plan doesn't cover; optional):
# https://finnhub.io (free: 60 calls/min)
FINNHUB_API_KEY=
# Tiingo (daily prices for symbols FMP's free plan doesn't cover, e.g. RDDT, BRK-B and ETFs; optional):
# https://www.tiingo.com (free: 50 calls/hour, 1000/day). Only called when FMP refuses a symbol.
TIINGO_API_KEY=

# Server
PORT=3001
# true = never call market data APIs, serve from cache/ only (use for live demos)
DEMO_MODE=false
CACHE_TTL_HOURS=12
DEMO_TICKERS=AAPL,NVDA,JPM,TSLA,GOOGL,MSFT,AMD
